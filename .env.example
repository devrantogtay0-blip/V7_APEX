# ═══════════════════════════════════════════════════════════
# 🐋 V7 APEX — Environment Variables (ÖRNEK)
# ═══════════════════════════════════════════════════════════
# KULLANIM:
#   1. Bu dosyayı .env olarak kopyala: cp .env.example .env
#   2. Kendi API anahtarlarını gir
#   3. .env dosyasını ASLA GitHub'a yükleme (.gitignore'da)
# ═══════════════════════════════════════════════════════════

# ─── SEKTÖR SEÇİMİ ───────────────────────────────────────
# Seçenekler: BANKACILIK | HAVACILIK | ENERJI
V7_SEKTOR=BANKACILIK

# ─── LOG SEVİYESİ ────────────────────────────────────────
# Seçenekler: DEBUG | INFO | WARNING | ERROR
SEEKDEEP_LOG=INFO

# ─── GROQ LLM (OPSİYONEL) ────────────────────────────────
# Haber sentiment analizi için
# Ücretsiz API: https://console.groq.com
GROQ_API_KEY=

# ─── FRED API (OPSİYONEL) ────────────────────────────────
# ABD makro verileri için
# Ücretsiz: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ─── TCMB EVDS (OPSİYONEL) ───────────────────────────────
# Türkiye makro verileri için
# Ücretsiz: https://evds3.tcmb.gov.tr
TCMB_EVDS_KEY=

# ─── MODEL AYARLARI (OPSİYONEL) ──────────────────────────
# Kullanılacak cihaz: cpu | cuda
V7_DEVICE=cpu

# Random seed (reproducibility için)
V7_SEED=42

# ─── STREAMLIT AYARLARI (OPSİYONEL) ──────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
